{
  "name": "@visualstandard/install",
  "version": "1.0.11",
  "description": "Auditable installer for Visual Standard Motion Graphics Creator.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Visual Standard <support@visualstandard.io>",
  "homepage": "https://visualstandard.io",
  "repository": {
    "type": "git",
